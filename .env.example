# Continuity OS · Environment Configuration
# Copy this file to .env and provide your desired credentials.

# --- Core Server Runtime ---
PORT=3000
NODE_ENV=development

# --- OpenRouter API Key ---
# Required for live sub-100ms Jev System-One decision gating (model: typesafe/jev-1.13).
# If left blank, Continuity OS executes deterministic local offline rubric scoring.
OPENROUTER_API_KEY=

# --- Dark Factory Autonomy Level (1 to 5) ---
# 1 = Human steers, 2 = Human specifies, 3 = Human in loop (PIV), 4 = Human on loop, 5 = Lights-out
FACTORY_AUTONOMY_LEVEL=4

# --- Worker Concurrency ---
WORKER_CONCURRENCY=4

# --- Optional Provider Keys ---
# For external frontier dispatching or external embedding models if desired
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
