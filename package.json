{
  "name": "continuity-os",
  "version": "1.0.0",
  "description": "Universal fullstack application template with PWA, Node.js API, SQLite, and Continuity OS AI orchestration",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/server.ts",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types server/server.ts",
    "test": "node --env-file-if-exists=.env --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "status": "bash scripts/status.sh",
    "manage": "python3 manage.py"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  }
}
